# Public site origin used for canonical URLs, sitemap.xml and social metadata (no trailing slash).
VITE_SITE_URL=https://www.example.com

# Enquiry form delivery endpoint. Must accept a JSON POST and return a 2xx status on success.
# Works with Formspree (https://formspree.io/f/<id>), Web3Forms, Getform, or your own serverless function.
# Leave empty and the form will NOT pretend to submit: it shows an honest fallback with your contact details.
VITE_FORM_ENDPOINT=

# Optional: extra fields some providers require (e.g. Web3Forms access_key). Sent as "access_key" if set.
VITE_FORM_ACCESS_KEY=
