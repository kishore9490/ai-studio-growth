# ─── Core ────────────────────────────────────────────────────────────────────
# PostgreSQL connection string
DATABASE_URL="postgresql://lifeos:lifeos@localhost:5432/lifeos"
# Used only by `npm run test:integration`
DATABASE_URL_TEST="postgresql://lifeos:lifeos@localhost:5432/lifeos_test"

# Public base URL (used for referral links and absolute URLs)
APP_URL="http://localhost:3000"

# Shows the demo banner, demo account hints and "sample data" labels.
DEMO_MODE="true"

# ─── Secrets (generate with: openssl rand -base64 32) ───────────────────────
# Signs expiring download links for paid digital assets.
DOWNLOAD_SIGNING_SECRET="change-me-download-secret-at-least-32-chars"

# ─── Payments ────────────────────────────────────────────────────────────────
# "mock" is the only provider wired up in this MVP. The mock provider is refused
# when NODE_ENV=production unless ALLOW_MOCK_PAYMENTS_IN_PRODUCTION="true"
# (intended only for a staging demo).
PAYMENT_PROVIDER="mock"
ALLOW_MOCK_PAYMENTS_IN_PRODUCTION="false"
# HMAC-SHA256 secret used to verify POST /api/webhooks/payments
PAYMENT_WEBHOOK_SECRET="change-me-webhook-secret"

# ─── AI Writing Workspace (optional) ────────────────────────────────────────
# Without a key, the writing tool runs a clearly labelled local fallback.
ANTHROPIC_API_KEY=""
AI_MODEL="claude-opus-5-5"

# ─── Storage ────────────────────────────────────────────────────────────────
# Directory for paid asset files. Must NOT be inside /public.
PRIVATE_STORAGE_DIR="./storage/private"
