# Copy to .env.local for local development. Never commit real secrets.

# Absolute production origin, without trailing slash. Used for canonical URLs,
# hreflang alternates, the sitemap, robots.txt, Open Graph and JSON-LD.
# No domain has been purchased yet; set this once one is confirmed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# When "true", clearly labelled development placeholders are shown where
# approved assets are still missing (portrait caption, media gallery tiles).
# Must be "false" (or unset) for production builds.
SHOW_DEV_PLACEHOLDERS=false

# When "true", search engines are asked not to index the site (robots.txt
# disallows all, pages carry noindex). Keep "true" on preview/staging
# deployments and until content has received final approval.
SITE_NOINDEX=true
