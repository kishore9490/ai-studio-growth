# Copy to .env for local development. .env is git-ignored.

# ---- database -------------------------------------------------------------
# When set, the API persists to PostgreSQL and hydrates from it at boot.
# Prisma also reads this file directly for `npm run db:*`.
DATABASE_URL=postgresql://bid:bid@127.0.0.1:5432/bidtrust

# Set to `memory` to run the API with no database at all — the fictional demo
# network is seeded in process and nothing is written anywhere.
# BID_PERSISTENCE=memory

# Write the demo network on first boot against an empty database. Set to false
# for an environment that should start with no data.
# BID_SEED_WHEN_EMPTY=false

# Points the durability test suite at a database. Unset, those tests skip.
# BID_TEST_DATABASE_URL=postgresql://bid:bid@127.0.0.1:5432/bidtrust

# ---- api ------------------------------------------------------------------
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
CORS_ORIGINS=http://localhost:5173,http://localhost:4173
PUBLIC_BASE_URL=https://bidtrust.in

# Demo master key. Real deployments issue per-workspace keys, stored hashed.
BID_DEMO_API_KEY=bid_demo_key
