# BID Trust — environment configuration
#
# Nothing in the domain reads process.env directly; configuration enters through
# apps/api/src/config.ts only.

# --- API ---------------------------------------------------------------------
NODE_ENV=development
PORT=4000
HOST=0.0.0.0
REQUEST_LOGGING=true

# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:5173,http://localhost:4173,http://localhost:8080

# Base URL used when building public profile links (bidtrust.in in production).
PUBLIC_BASE_URL=https://bidtrust.in

# Demo master API key. Production keys live in the database, hashed, per
# workspace, with scopes — this exists so the documented examples are runnable.
BID_DEMO_API_KEY=bid_demo_key

# --- Database (target; see prisma/schema.prisma) -----------------------------
DATABASE_URL=postgresql://bid:bid@localhost:5432/bidtrust

# --- Infrastructure abstractions (not yet wired) ------------------------------
# REDIS_URL=redis://localhost:6379
# QUEUE_URL=redis://localhost:6379
# OBJECT_STORAGE_ENDPOINT=http://localhost:9000
# OBJECT_STORAGE_BUCKET=bid-evidence
# SEARCH_URL=http://localhost:9200
# EVENT_BUS_URL=nats://localhost:4222

# --- Provider credentials -----------------------------------------------------
# Real adapters resolve credentials from a secrets manager by reference; never
# commit provider secrets. Placeholder shape only:
# PROVIDER_ACME_KYB_SECRET_REF=projects/bid/secrets/acme-kyb
